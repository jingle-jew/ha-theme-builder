{
  "name": "ha-theme-builder",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A completely graphical Home Assistant theme builder.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingle-jew/ha-theme-builder.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest --config frontend/vitest.config.ts",
    "test:run": "vitest run --config frontend/vitest.config.ts",
    "catalog:sync": "node tools/sync-theme-catalog.mjs",
    "release:zip": "npm run build && node tools/release-package.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "check": "npm run typecheck && npm run test:run && npm run build && npm run verify:package && python3 -m compileall -q custom_components/ha_theme_builder"
  },
  "dependencies": {
    "lit": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
